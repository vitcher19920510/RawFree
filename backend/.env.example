# Параметры сервера
PORT=3000
NODE_ENV=production
JWT_SECRET=change_me_generate_long_random_value

# Параметры хэширования Argon2 [ПРЕДПОЛОЖЕНИЕ — уточнить в документации]
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# База данных PostgreSQL 16 [ПРЕДПОЛОЖЕНИЕ — уточнить в документации]
POSTGRES_USER=rawfree
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=rawfree_db
DATABASE_URL="postgresql://rawfree:change_me_in_production@postgres:5432/rawfree_db?schema=public"

# In-memory кэш Redis 7 [ПРЕДПОЛОЖЕНИЕ — уточнить в документации]
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# Служба поддержки и контакты
SUPPORT_EMAIL=Vitcher1992@yandex.ru
