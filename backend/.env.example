# ============================================
# RawFree Backend Configuration
# ============================================

# --- Database ---
DATABASE_URL="postgresql://rawfree:password@localhost:5432/rawfree?schema=public"

# --- JWT ---
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# --- RuStore Billing ---
RUSTORE_APP_ID="ru.rustore.example"
RUSTORE_DEVELOPER_TOKEN="your-rustore-developer-token-here"

# --- SMS Provider (заглушка — заменить на реальный) ---
SMS_PROVIDER="stub"
# SMS_TWILIO_ACCOUNT_SID=""
# SMS_TWILIO_AUTH_TOKEN=""
# SMS_TWILIO_PHONE=""

# --- Email Provider (заглушка — заменить на реальный) ---
MAIL_PROVIDER="stub"
# MAIL_SENDGRID_API_KEY=""
# MAIL_FROM="noreply@rawfree.ru"

# --- File Storage (заглушка — заменить на Yandex Cloud S3) ---
STORAGE_PROVIDER="stub"
# STORAGE_ENDPOINT=""
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""

# --- Server ---
PORT=3000
NODE_ENV="development"

# --- Logging ---
LOG_LEVEL="info"

# --- CORS ---
CORS_ORIGIN="http://localhost:3001,https://admin.rawfree.ru"
