<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/spacing_8dp">

    <!-- Контейнер круглого видеосообщения -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_video_container"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:cardBackgroundColor="@color/bg_secondary"
        app:cardCornerRadius="100dp"
        app:cardElevation="@dimen/elevation_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Постер-превью до проигрывания -->
            <ImageView
                android:id="@+id/iv_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <!-- ExoPlayer Surface -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false" />

            <!-- Кольцо прогресса проигрывания -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_video_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:indicatorColor="@color/accent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:trackColor="@color/divider"
                app:trackThickness="4dp" />

            <!-- Кнопка Воспроизведения / Паузы -->
            <ImageView
                android:id="@+id/iv_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@android:drawable/ic_media_play"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <!-- Кнопка переключения скорости (1x / 2x) -->
            <TextView
                android:id="@+id/tv_speed_badge"
                style="@style/TextAppearance.RawFree.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_8dp"
                android:background="@color/surface_raised"
                android:paddingHorizontal="@dimen/spacing_8dp"
                android:paddingVertical="@dimen/spacing_4dp"
                android:text="@string/speed_1x"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- Время отправки и статус прочтения -->
    <TextView
        android:id="@+id/tv_message_time"
        style="@style/TextAppearance.RawFree.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4dp"
        android:textColor="@color/text_tertiary"
        app:layout_constraintEnd_toEndOf="@id/card_video_container"
        app:layout_constraintTop_toBottomOf="@id/card_video_container"
        tools:text="18:45 • Просмотрено" />

</androidx.constraintlayout.widget.ConstraintLayout>
